<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#00D4FF</item>
        <item name="colorPrimaryDark">#00A8CC</item>
        <item name="colorAccent">#00D4FF</item>

        <item name="android:windowBackground">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>

        <item name="android:forceDarkAllowed">true</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/black</item>
    </style>

    <style name="AppTheme.LauncherTheme" parent="AppTheme.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_cold_start</item>
        <item name="android:windowSplashScreenBackground">#0B001A</item>

        <item name="android:windowSplashScreenAnimatedIcon">@drawable/logo_with_text</item>
    </style>

    <style name="AppTheme.Fullscreen" parent="AppTheme.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>