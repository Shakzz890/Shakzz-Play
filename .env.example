# ==========================================
# Shakzz Play - Environment Variables Template
# ==========================================
# INSTRUCTIONS: Copy this file, rename it to '.env', 
# and fill in your actual API keys. 
# NEVER commit your actual '.env' file to GitHub!

# 🎬 TMDB (The Movie Database) API
VITE_TMDB_API_KEY=your_tmdb_api_key_here
VITE_TMDB_BASE_URL=https://api.themoviedb.org/3

# 🔥 Firebase Configuration (Cloud Sync & Auth)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# 📡 Cloudflare Reverse Proxy (IPTV Live Streams)
VITE_PROXY_BASE_URL=https://your-worker-name.your-username.workers.dev